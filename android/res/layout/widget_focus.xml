<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_focus" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone" android:padding="5dp" android:background="@drawable/widget_q0">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/focus_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical" android:textColor="#263C36" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/>
  <TextView android:id="@+id/focus_add" android:layout_width="44dp" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center" android:text="＋" android:textSize="24sp" android:textColor="#263C36" android:contentDescription="在当前象限添加事项"/>
  <TextView android:id="@+id/focus_back" android:layout_width="52dp" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center" android:text="总览" android:textSize="13sp" android:textColor="#263C36" android:contentDescription="返回桌面四象限总览"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:orientation="horizontal"><TextView android:id="@+id/switch0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/widget_q0" android:text="重要&#10;紧急" android:textSize="10sp" android:textColor="#263C36" android:contentDescription="切换桌面象限1"/><TextView android:id="@+id/switch1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/widget_q1" android:text="重要&#10;不紧急" android:textSize="10sp" android:textColor="#263C36" android:contentDescription="切换桌面象限2"/><TextView android:id="@+id/switch2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/widget_q2" android:text="不重要&#10;紧急" android:textSize="10sp" android:textColor="#263C36" android:contentDescription="切换桌面象限3"/><TextView android:id="@+id/switch3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/widget_q3" android:text="不重要&#10;不紧急" android:textSize="10sp" android:textColor="#263C36" android:contentDescription="切换桌面象限4"/></LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
 <ListView android:id="@+id/focus_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="3dp" android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent"/>
 <TextView android:id="@+id/focus_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center" android:text="这个象限暂无待办&#10;点右上角 ＋ 添加" android:textSize="14sp" android:textColor="#263C36"/>
 </FrameLayout></LinearLayout>
