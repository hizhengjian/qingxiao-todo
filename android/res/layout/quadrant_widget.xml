<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="6dp">
 <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical">
  <LinearLayout android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="vertical" android:gravity="center_vertical" android:contentDescription="打开轻效 Todo 四象限">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="轻效 Todo · 四象限" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#263C36" android:includeFontPadding="false"/>
   <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="今天 · 专注重要的事" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:visibility="visible" android:textColor="#263C36" android:includeFontPadding="false"/>
  </LinearLayout>
  <TextView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="↻" android:textSize="26sp" android:contentDescription="刷新本机事项" android:textColor="#263C36" android:includeFontPadding="false"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_notice" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:visibility="gone" android:textSize="14sp" android:textColor="#263C36"/>
 <LinearLayout android:id="@+id/widget_matrix" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:padding="3dp" android:orientation="vertical" android:background="@drawable/widget_q0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:orientation="horizontal" android:gravity="center_vertical">
     <TextView android:id="@+id/head0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="30dp" android:gravity="center_vertical" android:text="重要·紧急  0" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:contentDescription="展开重要·紧急" android:textColor="#263C36" android:includeFontPadding="false"/>
     <TextView android:id="@+id/add0" android:layout_width="28dp" android:layout_height="30dp" android:gravity="center" android:text="＋" android:textSize="22sp" android:contentDescription="在重要·紧急添加事项" android:textColor="#263C36" android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
     <ListView android:id="@+id/list0" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="1dp" android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent"/>
     <TextView android:id="@+id/empty0" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="暂无待办" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="#263C36"/>
    </FrameLayout>
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:padding="3dp" android:orientation="vertical" android:background="@drawable/widget_q1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:orientation="horizontal" android:gravity="center_vertical">
     <TextView android:id="@+id/head1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="30dp" android:gravity="center_vertical" android:text="重要·不紧急  0" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:contentDescription="展开重要·不紧急" android:textColor="#263C36" android:includeFontPadding="false"/>
     <TextView android:id="@+id/add1" android:layout_width="28dp" android:layout_height="30dp" android:gravity="center" android:text="＋" android:textSize="22sp" android:contentDescription="在重要·不紧急添加事项" android:textColor="#263C36" android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
     <ListView android:id="@+id/list1" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="1dp" android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent"/>
     <TextView android:id="@+id/empty1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="暂无待办" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="#263C36"/>
    </FrameLayout>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:padding="3dp" android:orientation="vertical" android:background="@drawable/widget_q2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:orientation="horizontal" android:gravity="center_vertical">
     <TextView android:id="@+id/head2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="30dp" android:gravity="center_vertical" android:text="不重要·紧急  0" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:contentDescription="展开不重要·紧急" android:textColor="#263C36" android:includeFontPadding="false"/>
     <TextView android:id="@+id/add2" android:layout_width="28dp" android:layout_height="30dp" android:gravity="center" android:text="＋" android:textSize="22sp" android:contentDescription="在不重要·紧急添加事项" android:textColor="#263C36" android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
     <ListView android:id="@+id/list2" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="1dp" android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent"/>
     <TextView android:id="@+id/empty2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="暂无待办" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="#263C36"/>
    </FrameLayout>
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:padding="3dp" android:orientation="vertical" android:background="@drawable/widget_q3">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:orientation="horizontal" android:gravity="center_vertical">
     <TextView android:id="@+id/head3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="30dp" android:gravity="center_vertical" android:text="不重要·不紧急  0" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:contentDescription="展开不重要·不紧急" android:textColor="#263C36" android:includeFontPadding="false"/>
     <TextView android:id="@+id/add3" android:layout_width="28dp" android:layout_height="30dp" android:gravity="center" android:text="＋" android:textSize="22sp" android:contentDescription="在不重要·不紧急添加事项" android:textColor="#263C36" android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
     <ListView android:id="@+id/list3" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="1dp" android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent"/>
     <TextView android:id="@+id/empty3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="暂无待办" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="#263C36"/>
    </FrameLayout>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
 <include layout="@layout/widget_focus"/>
 <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="18dp" android:gravity="center" android:text="列表可滑动 · 点标题放大 · ＋新增" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:visibility="visible" android:textColor="#263C36"/>
</LinearLayout>
