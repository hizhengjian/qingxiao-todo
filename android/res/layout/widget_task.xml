 <TextView android:id="@+id/task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:textColor="#263C36" android:includeFontPadding="false"/>
 <TextView android:id="@+id/task_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#263C36" android:includeFontPadding="false"/>
